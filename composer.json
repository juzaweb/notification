    "description": "Notification module for Juzaweb cms",
    "keywords": [
        "juzaweb",
        "notification",
        "cms",
        "module"
    ],
    "license": "MIT",
    "homepage": "https://juzaweb.com",
    "require": {
        "php": "^8.2",
        "juzaweb/core": "^5.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0",
        "phpunit/phpunit": "^10.0",
        "laravel/framework": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Juzaweb\\Modules\\Notification\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Juzaweb\\Modules\\Notification\\Tests\\": "tests/"
        }
    }
